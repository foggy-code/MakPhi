# Gli script eseguiti in Linux/macOS e nei container devono avere fine riga LF anche se modificati su Windows.
*.sh text eol=lf
*.command text eol=lf
programma/docker/**/* text=auto eol=lf
programma/launcher/*.yml text eol=lf
# VERSION si legge anche con $(cat ...) negli script e nella CI: niente CR finale
programma/launcher/VERSION text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.tar.gz binary
