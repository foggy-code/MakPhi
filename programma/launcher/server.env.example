# Configurazione di BioLoom su un server (copiata in server.env, nella cartella di BioLoom, da "avvia-bioloom.sh server").
# Avvio (dalla cartella di BioLoom): ./avvia-bioloom.sh server   oppure
#        docker compose -f programma/launcher/compose.yml --env-file server.env up -d
# Con UniClust30 senza l'avviatore aggiungi anche COMPOSE_PROFILES=qmean e
# BIOLOOM_QMEAN_URL=http://qmean:8080 (l'avviatore lo fa da solo se UNICLUST_PATH è impostato).

BIOLOOM_VERSION=4.1.0
BIOLOOM_PORT=8765
# 0.0.0.0 = raggiungibile dalla rete (con accesso protetto); 127.0.0.1 = solo dal server (es. dietro reverse proxy)
BIOLOOM_BIND=0.0.0.0
BIOLOOM_AUTH=on
BIOLOOM_ACCESS_KEY=
BIOLOOM_ALLOW_SHUTDOWN=0
BIOLOOM_RESTART=unless-stopped

# Cartella dati sul server (progetti, risultati, licenze, database pdbaa)
BIOLOOM_DATA_PATH=/srv/bioloom/data

# Database esterni (disco dedicato, montato in sola lettura)
UNICLUST_PATH=
QMTL_PATH=

# Servizio ESMFold per il confronto con una predizione (vuoto = API pubblica di ESM Atlas). In modalità server
# l'indirizzo si imposta solo qui, non dalle Impostazioni dell'interfaccia; l'invio resta da consentire lì.
BIOLOOM_ESMFOLD_URL=

# Licenze: la chiave MODELLER si può anche inserire dall'interfaccia (Impostazioni > Licenze)
MODELLER_KEY=
# MAC richiesto dalla licenza ProSA (3° campo del file LicenseDB, formato aa:bb:cc:dd:ee:ff)
BIOLOOM_MAC=02:42:b1:00:00:01
