# Configurazione di BioLoom su un server (copiata in server.env, nella cartella di BioLoom, da "avvia-bioloom.sh server").
# Avvio (dalla cartella di BioLoom): ./avvia-bioloom.sh server   oppure
#        docker compose -f programma/launcher/compose.yml --env-file server.env up -d
# Con UniClust30 senza l'avviatore aggiungi anche COMPOSE_PROFILES=qmean e
# BIOLOOM_QMEAN_URL=http://qmean:8080 (l'avviatore lo fa da solo se UNICLUST_PATH è impostato).
# La versione delle immagini non si imposta qui: è sempre quella di programma/launcher/VERSION (l'avviatore ignora,
# con un avviso, una BIOLOOM_VERSION rimasta in un server.env di una versione precedente).

BIOLOOM_PORT=8765
# 127.0.0.1 = raggiungibile solo dal server: dagli altri computer con un reverse proxy HTTPS o un tunnel SSH
# (Guida/5 - Chiavetta e server.md). 0.0.0.0 = dalla rete, ma in HTTP: chiave d'accesso e cookie viaggiano in chiaro,
# e la porta pubblicata da Docker scavalca il firewall (firewalld, ufw), che non la protegge. Solo su reti fidate.
BIOLOOM_BIND=127.0.0.1
BIOLOOM_AUTH=on
# Chiave d'accesso: almeno 16 caratteri, altrimenti BioLoom non parte (es. openssl rand -hex 12). L'avviatore ne scrive
# una casuale di 24 quando crea server.env; vuota = BioLoom ne genera una in data/access_key e la stampa nel log.
BIOLOOM_ACCESS_KEY=
# solo con BIOLOOM_AUTH=off: nomi o indirizzi con cui aprire BioLoom oltre a localhost e 127.0.0.1 (virgole; * = tutti)
BIOLOOM_ALLOWED_HOSTS=
# Solo dietro un reverse proxy che invia X-Forwarded-For (Caddy, nginx): indirizzi o reti CIDR del proxy (virgole), da
# cui BioLoom accetta X-Forwarded-For per distinguere i client nel freno ai tentativi d'accesso. Il valore giusto lo
# scrive il log di BioLoom al primo inserimento della chiave arrivato dal proxy (schermata d'accesso o Bearer; con una
# sessione già aperta esci prima): di solito il gateway della rete dei container (es. 172.18.0.1). Tutta la rete
# 172.16.0.0/12 solo con BIOLOOM_BIND=127.0.0.1: con 0.0.0.0 anche i client che si collegano direttamente da quella rete
# (computer della LAN, altri container) potrebbero scrivere X-Forwarded-For. Vuota = X-Forwarded-For ignorato; un
# valore sbagliato ferma l'avvio.
BIOLOOM_TRUSTED_PROXIES=
BIOLOOM_ALLOW_SHUTDOWN=0
BIOLOOM_RESTART=unless-stopped

# Cartella dati sul server (progetti, risultati, licenze, database pdbaa)
BIOLOOM_DATA_PATH=/srv/bioloom/data

# Database esterni (disco dedicato, montato in sola lettura)
UNICLUST_PATH=
QMTL_PATH=

# Servizio ESMFold per il confronto con una predizione (vuoto = API pubblica di ESM Atlas). In modalità server
# l'indirizzo si imposta solo qui, non dalle Impostazioni dell'interfaccia; l'invio resta da consentire lì.
BIOLOOM_ESMFOLD_URL=

# Server di posta per l'avviso alla fine delle pipeline (facoltativo, senza risultati nel messaggio). In modalità
# server si imposta solo qui; senza BIOLOOM_SMTP_HOST e BIOLOOM_SMTP_FROM l'avviso non si può chiedere.
# BIOLOOM_SMTP_SECURITY: starttls (porta 587), ssl (porta 465) o none; BIOLOOM_PUBLIC_URL = indirizzo di BioLoom
# per il link al job nel messaggio (vuoto = nessun link).
BIOLOOM_SMTP_HOST=
BIOLOOM_SMTP_PORT=587
BIOLOOM_SMTP_SECURITY=starttls
BIOLOOM_SMTP_USER=
BIOLOOM_SMTP_PASSWORD=
BIOLOOM_SMTP_FROM=
BIOLOOM_PUBLIC_URL=

# Licenze: la chiave MODELLER si può anche inserire dall'interfaccia (Impostazioni > Licenze)
MODELLER_KEY=
# Interprete Python con MODELLER, percorso dentro il container (in modalità server si imposta solo qui, non dalle
# Impostazioni dell'interfaccia); vuoto = rilevamento automatico, cioè il Python dell'immagine di BioLoom.
BIOLOOM_MODELLER_PYTHON=
# MAC richiesto dalla licenza ProSA (3° campo del file LicenseDB, formato aa:bb:cc:dd:ee:ff)
BIOLOOM_MAC=02:42:b1:00:00:01

# QMEAN locale (attivo quando l'avviatore trova UniClust30/UniRef30, UNICLUST_PATH). Calcoli contemporanei: ognuno è un
# HHblits con la sua copia degli indici in memoria (circa 12-15 GB); su un server con molta memoria per esempio 16, il
# servizio li riduce da sé se la memoria non basta. 1 = uno alla volta.
QMEAN_PARALLEL=1
# Processori di ogni HHblits; vuoto = fino a 8, divisi fra i calcoli contemporanei
QMEAN_HHBLITS_CPU=
# Spazio (GB) per i profili HHblits riusati: una sequenza già valutata non rifà la ricerca su UniRef30; 0 = mai
QMEAN_PROFILE_CACHE_GB=10
