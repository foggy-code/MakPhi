# Server di posta per l'avviso alla fine delle pipeline di BioLoom (facoltativo).
#
# Copia questo file nella cartella dati come  licenses/posta.env  (es. D:\BIOLum_v4\data\licenses\posta.env)
# e compila i valori. Non si modifica dall'interfaccia: chi usa BioLoom sceglie solo se ricevere l'avviso e a
# quale indirizzo. Le modifiche valgono subito, senza riavviare. Sul server, in alternativa, le stesse variabili
# si possono mettere in server.env (hanno la precedenza sul file).
#
# Esempio con un account Gmail dedicato (serve una "password per le app", non la password dell'account):
#   BIOLOOM_SMTP_HOST=smtp.gmail.com
#   BIOLOOM_SMTP_PORT=587
#   BIOLOOM_SMTP_SECURITY=starttls
#   BIOLOOM_SMTP_USER=bioloom.avvisi@gmail.com
#   BIOLOOM_SMTP_PASSWORD=abcdefghijklmnop
#   BIOLOOM_SMTP_FROM=bioloom.avvisi@gmail.com

# Server SMTP (obbligatorio)
BIOLOOM_SMTP_HOST=
# 587 con starttls, 465 con ssl, 25 con none
BIOLOOM_SMTP_PORT=587
# starttls, ssl oppure none (none solo su reti fidate, per esempio il relay interno dell'università)
BIOLOOM_SMTP_SECURITY=starttls
# Utente e password dell'account di posta (vuoti se il server non chiede l'accesso)
BIOLOOM_SMTP_USER=
BIOLOOM_SMTP_PASSWORD=
# Mittente dei messaggi (obbligatorio; di solito lo stesso indirizzo dell'utente)
BIOLOOM_SMTP_FROM=
# Indirizzo di BioLoom per il link al job nel messaggio (facoltativo, es. https://bioloom.universita.it)
BIOLOOM_PUBLIC_URL=
