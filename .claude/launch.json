{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "makphi",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "programma/launcher/compose.yml",
        "--env-file",
        ".env.locale",
        "up"
      ],
      "port": 8765
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "programma/frontend",
        "run",
        "dev",
        "--",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "programma/frontend",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}